FROM alpine:3.20 AS web
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories \
 && apk add --no-cache nodejs npm
WORKDIR /web
COPY platform/web/package.json platform/web/package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com --fetch-retries=8 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000
COPY platform/web/ ./
RUN npm run build

FROM alpine:3.20
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories \
 && apk add --no-cache nginx && mkdir -p /run/nginx
COPY --from=web /web/dist /usr/share/nginx/html/minikitex
COPY platform/web/nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
