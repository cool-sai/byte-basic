FROM docker.m.daocloud.io/library/node:20-alpine AS build
WORKDIR /web
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories
COPY home/web/package.json home/web/package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com --fetch-retries=8 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000
COPY home/web/ ./
RUN npm run build

FROM docker.m.daocloud.io/library/alpine:3.20
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories \
 && apk add --no-cache nginx && mkdir -p /run/nginx
COPY --from=build /web/dist /usr/share/nginx/html
COPY home/web/nginx.conf /etc/nginx/nginx.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
